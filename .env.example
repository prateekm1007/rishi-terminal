# Rishi Terminal — environment template
#
# Copy to .env.local and fill in values. NEVER commit real .env files.
# Every variable below is one the application code actually reads.

# ── Supabase (database + auth) ────────────────────────────────
# Project URL and anon key are safe for the browser (RLS-protected).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key bypasses RLS — SERVER ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI ────────────────────────────────────────────────────────
# Primary chat provider: any OpenAI-compatible endpoint — server only.
# Example: CHAT_API_BASE_URL=https://apihub.agnes-ai.com/v1
# The key is sent via the Authorization: Bearer header, never the URL.
CHAT_API_BASE_URL=
CHAT_API_KEY=
# Model id served by that endpoint (default: agnes-2.5-flash).
CHAT_MODEL=
# Legacy fallback: Google Gemini (used only when CHAT_API_* is unset).
# Key is sent via the x-goog-api-key header.
GEMINI_API_KEY=

# ── Market data ───────────────────────────────────────────────
# Financial Modeling Prep — server only.
FMP_API_KEY=

# ── Payments ─────────────────────────────────────────────────
# RETIRED (2026-10-02): every feature is free — there is no checkout and
# no payment processor. The RAZORPAY_* variables are no longer read.
# Historical transaction rows remain preserved in the database.

# ── App / infrastructure ──────────────────────────────────────
# Public base URL used for callbacks and share links.
NEXT_PUBLIC_BASE_URL=
# Shared secret for Vercel Cron → ingest routes (sent as Authorization: Bearer).
CRON_SECRET=

# ── W3 (founder round-10): chat cost safety ────────────────────────────
# Kill switch (ONE contract, identical in code/docs/tests): unset, "", or
# one of the explicit false-y spellings 0/false/no/off (case-insensitive)
# leaves chat ENABLED; EVERY other non-empty value ("1", "true", "yes",
# "on", or a typo like "ture") DISABLES chat — the honest "temporarily
# unavailable" fallback for every request, before any quota, evidence, or
# upstream work. A typo must fail toward OFF: this is a cost kill switch.
# CHAT_DISABLED=1
# REQUIRED for anonymous chat (fail closed): the HMAC pepper for the
# pseudonymous per-IP quota identity (lib/auth/anonIdentity.ts). Generate
# e.g. with: openssl rand -hex 32. Rotating it resets anonymous quota
# identities exactly once; signed-in users are unaffected.
ANON_ID_PEPPER=
# Global daily spend caps (defaults shown; founder-tunable):
# total chat requests per IST day across ALL callers (default 2000).
# CHAT_GLOBAL_DAILY_REQUESTS=2000
# A HARD bound on total provider spend per IST day across ALL callers
# (default 2000000): every request RESERVES the single-request ceiling
# (288576 tokens, mechanically derived from the loop bounds in
# lib/chat/globalSpend.ts) before the provider call and settles to the
# reported usage after. Concurrency can never admit past the cap; a
# value smaller than the ceiling admits nothing (fail closed by design).
# CHAT_GLOBAL_DAILY_TOKENS=2000000

# ── U4 (founder round 7): ranked widgets gate ──────────────────────────
# The dashboard's ranked widgets (Top Buy Signals, Short Radar, Stock of
# the Day) run ONLY when this is exactly "true" (fail-closed — any other
# value, including unset, keeps them off; see lib/featureFlags.ts).
# RANKINGS_ENABLED=true
