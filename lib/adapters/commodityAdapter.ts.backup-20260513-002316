import { UniversalAsset } from '../types/asset';

interface Commodity {
  symbol: string;
  name: string;
  price: number;
  change24h: number;
  unit: string;
  category: string;
  sector?: string;
  description: string;
  exchange: string;
}

export function adaptCommodity(commodity: Commodity): UniversalAsset {
  return {
    symbol: commodity.symbol,
    name: commodity.name,
    category: 'commodity',
    price: commodity.price,
    change24h: commodity.change24h,
    metadata: {
      unit: commodity.unit,
      commodityCategory: commodity.category,
      sector: commodity.sector || commodity.category,
      exchange: commodity.exchange,
      description: commodity.description
    }
  };
}