import { UniversalAsset } from "../types/asset";

export function adaptCrypto(crypto: any): UniversalAsset {
  return {
    symbol: crypto.symbol,
    name: crypto.name,
    category: 'crypto',

    price: crypto.price,
    change24h: crypto.change24h,

    marketCap: crypto.marketCap,
    volume24h: crypto.volume24h,
    volatility: crypto.rsi,

    metadata: crypto,
  };
}