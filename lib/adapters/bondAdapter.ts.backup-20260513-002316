import { UniversalAsset } from "../types/asset";

export function adaptBond(bond: any): UniversalAsset {
  return {
    symbol: bond.symbol,
    name: bond.name,
    category: 'bond',

    price: bond.ytm,
    change24h: 0,

    sector: bond.type,

    volatility: bond.duration,

    metadata: bond,
  };
}