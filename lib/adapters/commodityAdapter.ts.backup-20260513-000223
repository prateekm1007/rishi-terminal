import { UniversalAsset } from "../types/asset";

export function adaptCommodity(commodity: any): UniversalAsset {
  return {
    symbol: commodity.symbol,
    name: commodity.name,
    category: 'commodity',

    price: commodity.price,
    change24h: commodity.changePct,

    sector: commodity.category,

    volatility: Math.abs(commodity.changePct),

    metadata: commodity,
  };
}