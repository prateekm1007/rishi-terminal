// Get crypto metrics
export function getCryptoMetrics() {
  const totalMarketCap = CRYPTO_DATA.reduce((sum, crypto) => sum + crypto.marketCap, 0);
  const total24hVolume = CRYPTO_DATA.reduce((sum, crypto) => sum + crypto.volume24h, 0);
  const avgChange = CRYPTO_DATA.reduce((sum, crypto) => sum + crypto.change24h, 0) / CRYPTO_DATA.length;
  
  return {
    totalMarketCap,
    total24hVolume,
    avgChange24h: avgChange,
    activeCryptos: CRYPTO_DATA.length,
    btcDominance: MARKET_DOMINANCE.BTC,
    fearGreedIndex: FEAR_GREED_INDEX.value
  };
}

// Get crypto by symbol
export function getCryptoBySymbol(symbol: string): Crypto | undefined {
  return CRYPTO_DATA.find(c => c.symbol.toUpperCase() === symbol.toUpperCase());
}