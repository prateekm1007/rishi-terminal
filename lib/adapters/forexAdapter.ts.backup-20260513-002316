import { UniversalAsset } from "../types/asset";

export function adaptForex(pair: any): UniversalAsset {
  return {
    symbol: pair.symbol,
    name: pair.name,
    category: 'forex',

    price: pair.spotRate,
    change24h: pair.change24h,

    volatility: pair.volatility,
    volume24h: pair.volume24h,

    metadata: pair,
  };
}