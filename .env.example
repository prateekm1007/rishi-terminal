# Rishi Terminal — environment template
#
# Copy to .env.local and fill in values. NEVER commit real .env files.
# Every variable below is one the application code actually reads.

# ── Supabase (database + auth) ────────────────────────────────
# Project URL and anon key are safe for the browser (RLS-protected).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key bypasses RLS — SERVER ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI ────────────────────────────────────────────────────────
# Primary chat provider: any OpenAI-compatible endpoint — server only.
# Example: CHAT_API_BASE_URL=https://apihub.agnes-ai.com/v1
# The key is sent via the Authorization: Bearer header, never the URL.
CHAT_API_BASE_URL=
CHAT_API_KEY=
# Model id served by that endpoint (default: agnes-2.5-flash).
CHAT_MODEL=
# Legacy fallback: Google Gemini (used only when CHAT_API_* is unset).
# Key is sent via the x-goog-api-key header.
GEMINI_API_KEY=

# ── Market data ───────────────────────────────────────────────
# Financial Modeling Prep — server only.
FMP_API_KEY=
# Finnhub — server only (moved out of NEXT_PUBLIC_ in remediation T3).
FINNHUB_API_KEY=

# ── Payments (Razorpay) ───────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signature secret (set in Razorpay dashboard).
RAZORPAY_WEBHOOK_SECRET=

# ── App / infrastructure ──────────────────────────────────────
# Public base URL used for callbacks and share links.
NEXT_PUBLIC_BASE_URL=
# Shared secret for Vercel Cron → ingest routes (sent as Authorization: Bearer).
CRON_SECRET=
